# ワークスペース全体の設定 (cp .env.example .env して編集)
# make 実行時に引数で上書き可能: make laravel NAME=blog DOMAIN=example.com

# メインドメイン。アプリは <NAME>.<DOMAIN> で作成される
#   ローカル: hogehoge.localhost  → blog.hogehoge.localhost (http)
#   サーバー: example.com         → blog.example.com (https / Let's Encrypt)
DOMAIN=localhost

# DOMAIN が *.localhost 以外のとき Let's Encrypt の証明書発行に使う
LETSENCRYPT_EMAIL=

TZ=Asia/Tokyo
